# ContentPlan — contoh Environment Variables Vercel.
# Salin ke pengaturan Environment Variables di Vercel, isi nilainya di sana.
# JANGAN pernah mengisi nilai asli di file ini dan JANGAN commit file .env.
#
# GAS_WEB_APP_URL: URL Web App deployment Google Apps Script (diakhiri /exec)
# GAS_API_SECRET: secret bersama antara Vercel dan GAS (buat string acak panjang)
# CRON_SECRET: secret khusus untuk memicu /api/cron-publish dari layanan cron eksternal
# META_APP_ID / META_IG_CONFIG_ID / META_APP_SECRET: kredensial aplikasi Meta (Instagram & Threads)
# THREADS_APP_ID / THREADS_APP_SECRET: kredensial aplikasi Threads (boleh memakai kredensial Meta bila sama)
# TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET: kredensial aplikasi TikTok
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: kredensial OAuth Google (YouTube)
GAS_WEB_APP_URL=
GAS_API_SECRET=
CRON_SECRET=
META_APP_ID=
META_IG_CONFIG_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
